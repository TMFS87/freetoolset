# ============================================================================
# FreeToolset — environment variables (Vercel / Serverless Functions)
# Copy this file to ".env.local" for local dev, or set these in the
# Vercel project dashboard (Settings -> Environment Variables).
# NEVER commit the real values.
# ============================================================================

# ---- AI providers (used by api/ai-proxy.js) ----
GLM_API_KEY=your_zhipu_glm_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- Upstash Redis (used by api/credits.js and api/contact.js) ----
# Find these in your Upstash Redis database dashboard (REST API section).
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token_here

# ---- NOWPayments (used by api/create-payment.js and api/payment-webhook.js) ----
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_KEY=your_nowpayments_ipn_secret_here
